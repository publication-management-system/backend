<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1779877963707-1" author="Cristian Ginju">
        <createTable tableName="task_resource">
            <column name="id" type="binary(16)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="resource_name" type="VARCHAR(255)"/>
            <column name="resource_type" type="VARCHAR(50)"/>
            <column name="data" type="LONGBLOB"/>
            <column name="task_id" type="binary(16)"/>
            <column name="url" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
</databaseChangeLog>